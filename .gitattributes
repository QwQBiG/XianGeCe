# UTF-8 text uses LF on Windows and Linux; Windows command wrappers use CRLF.
* text=auto
.gitignore text eol=lf
.gitattributes text eol=lf
*.md text eol=lf
*.txt text eol=lf
LICENSE text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
gradlew text eol=lf
.githooks/* text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.zip binary
