<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/agenda_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_background">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="今日安排" android:textColor="#214E45" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="接下来要去哪里" android:textColor="#8C948D" android:textSize="10sp" />
    <TextView android:id="@+id/agenda_row_1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:padding="6dp" android:background="#F3EBDD" android:textColor="#214E45" android:textSize="12sp" />
    <TextView android:id="@+id/agenda_row_2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:gravity="center_vertical" android:padding="6dp" android:background="#F3EBDD" android:textColor="#214E45" android:textSize="12sp" />
    <TextView android:id="@+id/agenda_row_3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="4dp" android:gravity="center_vertical" android:padding="6dp" android:background="#F3EBDD" android:textColor="#214E45" android:textSize="12sp" />
</LinearLayout>
